# ---------------------------------------------------------------------------
# STUDENT DATA - never commit
# ---------------------------------------------------------------------------
# Real rosters (and their hand-written expected results) live only here:
private_rosters/
# Any PDF except the FAKE test fixtures (real rosters, generated help sheets):
*.pdf
!tests/fixtures/*.pdf
# Generated Event CSVs and any spreadsheet exports (every roster-like type the
# build refuses to package):
*.csv
*.tsv
*.xls
*.xlsx
*.xlsm
*.xlsb
*.ods
*.numbers
# ...except the FAKE test fixtures (invented data only):
!tests/fixtures/*.csv
!tests/fixtures/*.xlsx
# A file marked as real is never committed, not even under tests/fixtures/
# (this must come after the fixture exceptions above to win over them):
*.real.pdf

# ---------------------------------------------------------------------------
# Python / build artifacts
# ---------------------------------------------------------------------------
.venv/
.venv-*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
build/
dist/

# ---------------------------------------------------------------------------
# Root-level packaged app copies (discoverability only; the validated
# originals live under dist/). Generated by the build; never source.
# ---------------------------------------------------------------------------
/Roster Tool.app/
/Roster Tool - Windows/

